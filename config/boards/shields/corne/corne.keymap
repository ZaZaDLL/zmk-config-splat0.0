#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    chosen {
        zmk,matrix_transform = &default_transform;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <4>;

        // 3x6 + 3 thumbs on Left, 3x6 + 3 thumbs on Right
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)    RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)    RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)    RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
                            RC(3,3) RC(3,4) RC(3,5)    RC(3,6) RC(3,7) RC(3,8)
        >;
    };

    behaviors {
        // Left hand left thumb: Hold for Upper Layer (2), Tap for Percent (%)
        lt_prcnt: layer_tap_percent {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_PERCENT";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Base Layer
        default_layer {
            bindings = <
                // LEFT HAND                                        // RIGHT HAND
                &kp ESC    &kp Q  &kp W  &kp E  &kp R  &kp T        &kp Y  &kp U  &kp I      &kp O    &kp P     &kp BSPC
                &kp TAB    &kp A  &kp S  &kp D  &kp F  &kp G        &kp H  &kp J  &kp K      &kp L    &kp SEMI  &kp RET
                &kp LCTRL  &kp Z  &kp X  &kp C  &kp V  &kp B        &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp LSHFT
                          &lt_prcnt 2 PRCNT  &kp SPACE &none        &none  &kp SPACE &lt 1 RET
            >;
        };

        // Lower Layer (1)
        lower_layer {
            bindings = <
                &trans  &kp EXCL  &kp AT    &kp HASH  &kp DLLR  &kp PRCNT    &kp CARET &kp AMPS  &kp ASTR  &kp LPAR  &kp RPAR  &trans
                &trans  &kp MINUS &kp EQUAL &kp LBKT  &kp RBKT  &trans       &trans    &trans    &trans    &trans    &trans    &trans
                &trans  &kp GRAVE &kp BSLH  &kp LPAR  &kp RPAR  &trans       &trans    &trans    &trans    &trans    &trans    &trans
                                  &trans    &trans    &trans       &trans    &trans    &trans
            >;
        };

        // Upper Layer (2) - Bluetooth & Home Row Numbers
        upper_layer {
            bindings = <
                &trans      &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                &trans      &kp N1      &kp N2        &kp N3        &kp N4        &kp N5    &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &trans
                &bt BT_NXT  &trans      &trans        &trans        &trans        &trans    &trans  &trans  &trans  &trans  &trans  &trans
                                        &trans        &trans        &trans        &trans    &trans  &trans
            >;
        };
    };
};
